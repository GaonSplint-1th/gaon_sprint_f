# 백엔드 서버 주소 (쿠팡 API 프록시 포함)
# 로컬 개발용. 프로덕션 빌드는 .env.production 의 값이 사용된다.
VITE_SERVER_URL=http://localhost:8080

# 이미지 호스트. 비워 두면 VITE_SERVER_URL 을 쓴다.
# DB 는 /images/... 상대경로만 들고 있어, 화면과 이미지가 다른 오리진이면
# (운영: 화면 Amplify / 이미지 api 도메인) 여기에 이미지 쪽 주소가 필요하다.
# 게이트웨이 뒤에서 한 오리진으로 서빙할 때는 둘 다 비워 두면 된다.
VITE_IMAGE_BASE_URL=

# true로 설정 시 레시피 API 실패 시 목데이터로 대체 (백엔드 /recipes/:id 완성 전 임시 옵션)
VITE_USE_MOCK_RECIPE=false
